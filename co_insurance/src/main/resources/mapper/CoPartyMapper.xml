<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.xiaoxu.mapper.CoPartyMapper">

    <resultMap id="CoPartyResultMap" type="org.xiaoxu.entity.CoParty">
        <id     property="partyId"      column="party_id"/>
        <result property="draftId"      column="draft_id"/>
        <result property="insurerCode"  column="insurer_code"/>
        <result property="insurerName"  column="insurer_name"/>
        <result property="shareRatio"   column="share_ratio"/>
        <result property="lead"         column="is_lead"/>
        <result property="sortOrder"    column="sort_order"/>
        <result property="createdAt"    column="created_at"/>
    </resultMap>

    <!-- ── 按草稿ID查询所有共保方（按 sortOrder 升序，最后一个承担尾差） ── -->
    <select id="selectByDraftId" resultMap="CoPartyResultMap">
        SELECT * FROM insurance_co_party
         WHERE draft_id = #{draftId}
         ORDER BY sort_order ASC
    </select>

    <!-- ── 比例之和校验（录单保存时调用）──────────────────────────────────── -->
    <select id="sumRatioByDraftId" resultType="java.math.BigDecimal">
        SELECT COALESCE(SUM(share_ratio), 0)
          FROM insurance_co_party
         WHERE draft_id = #{draftId}
    </select>

    <!-- ── 批量插入共保方配置 ────────────────────────────────────────────── -->
    <insert id="insertBatch" parameterType="java.util.List">
        INSERT INTO insurance_co_party (
            party_id, draft_id, insurer_code, insurer_name,
            share_ratio, is_lead, sort_order, created_at
        ) VALUES
        <foreach collection="list" item="item" separator=",">
        (
            #{item.partyId}, #{item.draftId}, #{item.insurerCode}, #{item.insurerName},
            #{item.shareRatio}, #{item.lead}, #{item.sortOrder}, NOW()
        )
        </foreach>
    </insert>

</mapper>