<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.xiaoxu.mapper.PolicyMapper">

    <resultMap id="PolicyResultMap" type="org.xiaoxu.entity.Policy">
        <id     property="policyId"         column="policy_id"/>
        <result property="policyNo"         column="policy_no"/>
        <result property="draftId"          column="draft_id"/>
        <result property="paymentBatchNo"   column="payment_batch_no"/>
        <result property="coInsureType"     column="co_insure_type"
                typeHandler="org.apache.ibatis.type.EnumTypeHandler"/>
        <result property="productType"      column="product_type"/>
        <result property="insuredName"      column="insured_name"/>
        <result property="totalAmount"      column="total_amount"/>
        <result property="totalPremium"     column="total_premium"/>
        <result property="ownRatio"         column="own_ratio"/>
        <result property="ownPremium"       column="own_premium"/>
        <result property="policyStatus"     column="policy_status"
                typeHandler="org.apache.ibatis.type.EnumTypeHandler"/>
        <result property="splitStatus"      column="split_status"
                typeHandler="org.apache.ibatis.type.EnumTypeHandler"/>
        <result property="policySnapshot"   column="policy_snapshot"/>
        <result property="insuranceStart"   column="insurance_start"/>
        <result property="insuranceEnd"     column="insurance_end"/>
        <result property="createdBy"        column="created_by"/>
        <result property="createdAt"        column="created_at"/>
        <result property="updatedAt"        column="updated_at"/>
    </resultMap>

    <!-- ── 写入主保单 ─────────────────────────────────────────────────────── -->
    <insert id="insert" parameterType="org.xiaoxu.entity.Policy"
            useGeneratedKeys="true" keyProperty="policyId">
        INSERT INTO insurance_policy (
            policy_id, policy_no, draft_id, payment_batch_no,
            co_insure_type, product_type, insured_name,
            total_amount, total_premium, own_ratio, own_premium,
            policy_status, split_status, policy_snapshot,
            insurance_start, insurance_end, created_by, created_at
        ) VALUES (
                     #{policyId}, #{policyNo}, #{draftId}, #{paymentBatchNo},
                     #{coInsureType}, #{productType}, #{insuredName},
                     #{totalAmount}, #{totalPremium}, #{ownRatio}, #{ownPremium},
                     #{policyStatus}, #{splitStatus}, #{policySnapshot},
                     #{insuranceStart}, #{insuranceEnd}, #{createdBy}, NOW()
                 )
    </insert>

    <!-- ── 更新保单状态（状态机流转后调用）────────────────────────────────── -->
    <update id="updateStatus">
        UPDATE insurance_policy
        SET policy_status = #{policyStatus},
            updated_at    = NOW()
        WHERE policy_id     = #{policyId}
    </update>

    <!-- ── 更新拆单聚合状态 ───────────────────────────────────────────────── -->
    <update id="updateSplitStatus">
        UPDATE insurance_policy
        SET split_status = #{splitStatus},
            updated_at   = NOW()
        WHERE policy_no    = #{policyNo}
    </update>

    <!-- ── 同时更新保单状态 + 拆单状态（出单同步拆单场景） ─────────────────── -->
    <update id="updateStatusAndSplitStatus">
        UPDATE insurance_policy
        SET policy_status = #{policyStatus},
            split_status  = #{splitStatus},
            updated_at    = NOW()
        WHERE policy_id     = #{policyId}
    </update>

    <!-- ── 按保单号查询（加行锁，批改/退保场景） ─────────────────────────── -->
    <select id="selectByPolicyNoForUpdate" resultMap="PolicyResultMap">
        SELECT * FROM insurance_policy
        WHERE policy_no = #{policyNo}
            FOR UPDATE
    </select>

    <!-- ── 按草稿ID查询（出单幂等回查）──────────────────────────────────── -->
    <select id="selectByDraftId" resultMap="PolicyResultMap">
        SELECT * FROM insurance_policy
        WHERE draft_id = #{draftId}
        LIMIT 1
    </select>

    <!-- ── 按草稿ID + 收款批次号查询（见费出单幂等回查）─────────────────── -->
    <select id="selectByDraftIdAndPaymentBatchNo" resultMap="PolicyResultMap">
        SELECT * FROM insurance_policy
        WHERE draft_id          = #{draftId}
          AND payment_batch_no  = #{paymentBatchNo}
        LIMIT 1
    </select>

    <!-- ── 按保单号查询 ───────────────────────────────────────────────────── -->
    <select id="selectByPolicyNo" resultMap="PolicyResultMap">
        SELECT * FROM insurance_policy
        WHERE policy_no = #{policyNo}
        LIMIT 1
    </select>

    <!-- ── 查询所有 PENDING 状态的共保保单（异步拆单监控/补偿用）─────────── -->
    <select id="selectPendingSplitPolicies" resultMap="PolicyResultMap">
        SELECT * FROM insurance_policy
        WHERE split_status = 'PENDING'
          AND co_insure_type IN ('LEAD', 'FOLLOW')
          AND created_at &lt; #{beforeTime}
        ORDER BY created_at ASC
        LIMIT #{limit}
    </select>

</mapper>