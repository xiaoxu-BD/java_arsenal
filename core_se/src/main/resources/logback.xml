<configuration>

    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
        <pattern>%cyan(traceId:[%X{traceId}]) %red(%d{yyyy-MM-dd HH:mm:ss}) %green([%thread]) %highlight(%-5level) %boldMagenta(%logger{50}) - %msg%n</pattern>
    </encoder>
    </appender>
    <root level="info">
        <appender-ref ref="console" />
    </root>

</configuration>