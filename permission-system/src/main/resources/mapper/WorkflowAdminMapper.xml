<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.xiaoxu.workflow.mapper.WorkflowAdminMapper">

    <!-- 结果集字段名与 WorkflowItemVO 一一对应；
         注意两张表的流程实例字段名不同（process_instance_id / process_inst_id），
         在各自子查询里统一 alias 成 process_instance_id。-->
    <resultMap id="WorkflowItemMap" type="org.xiaoxu.workflow.vo.WorkflowItemVO">
        <result property="businessType"      column="business_type"/>
        <result property="businessId"        column="business_id"/>
        <result property="businessKey"       column="business_key"/>
        <result property="title"             column="title"/>
        <result property="applicant"         column="applicant"/>
        <result property="status"            column="status"/>
        <result property="processInstanceId" column="process_instance_id"/>
        <result property="amount"            column="amount"/>
        <result property="leaveDay"          column="leave_day"/>
        <result property="createTime"        column="create_time"/>
        <result property="updateTime"        column="update_time"/>
    </resultMap>

    <select id="selectAll" resultMap="WorkflowItemMap">
        SELECT * FROM (
            SELECT
                'leave'              AS business_type,
                id                   AS business_id,
                identifier           AS business_key,
                leave_reason         AS title,
                user_name            AS applicant,
                status,
                process_instance_id  AS process_instance_id,
                create_time,
                update_time,
                NULL                 AS amount,
                leave_day            AS leave_day
            FROM approve_leave
            WHERE deleted = '0'

            UNION ALL

            SELECT
                'fulfillment'        AS business_type,
                id                   AS business_id,
                order_no             AS business_key,
                title                AS title,
                applicant            AS applicant,
                status,
                process_inst_id      AS process_instance_id,
                create_time,
                update_time,
                amount               AS amount,
                NULL                 AS leave_day
            FROM fulfillment_order
            WHERE deleted = '0'
        ) t
        <where>
            <if test="query.businessType != null and query.businessType != ''">
                AND t.business_type = #{query.businessType}
            </if>
            <if test="query.status != null and query.status != ''">
                AND t.status = #{query.status}
            </if>
            <if test="query.applicant != null and query.applicant != ''">
                AND t.applicant LIKE CONCAT('%', #{query.applicant}, '%')
            </if>
        </where>
        ORDER BY t.create_time DESC
    </select>

</mapper>
