<?xml version="1.0" encoding="UTF-8"?>
<!--
    日志输出到文件，路径由 Spring 属性 LOG_PATH 控制：
      - 容器内默认 /app/logs/permission-service
      - 部署时 deploy.sh 把宿主机目录挂载到该路径，容器重建日志不丢
-->
<configuration>

    <!-- 从 Spring 环境读取日志路径，优先级：环境变量 LOG_PATH > 默认值 -->
    <springProperty name="LOG_PATH" source="logging.file.path" defaultValue="/app/logs/permission-service"/>

    <!-- 控制台输出 -->
    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%cyan(traceId:[%X{traceId}]) %red(%d{yyyy-MM-dd HH:mm:ss}) %green([%thread]) %highlight(%-5level) %boldMagenta(%logger{50}) - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 文件输出 - 按天滚动 -->
    <appender name="file" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/permission-service.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/permission-service.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{50} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="info">
        <appender-ref ref="console"/>
        <appender-ref ref="file"/>
    </root>

</configuration>
