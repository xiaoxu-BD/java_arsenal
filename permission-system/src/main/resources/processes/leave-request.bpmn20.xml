<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:flowable="http://flowable.org/bpmn" targetNamespace="http://www.xiaoxu.org/hr">
  <process id="leave-request" name="请假审批流程" isExecutable="true">
    <!-- ===== 开始 ===== -->
    <startEvent id="startEvent" name="提交请假"/>
    <sequenceFlow id="flow1" sourceRef="startEvent" targetRef="managerApproval"/>
    <!-- ===== 主管审批 ===== -->
    <userTask id="managerApproval" name="直属主管审批"
              flowable:candidateGroups="ROLE_MANAGER"
              flowable:formKey="leave_request_form">
      <documentation>直属主管审核请假申请</documentation>
    </userTask>
    <sequenceFlow id="flow2" sourceRef="managerApproval" targetRef="managerDecision"/>
    <exclusiveGateway id="managerDecision" name="主管审批决策"/>
    <sequenceFlow id="flow2_approved" name="主管通过" sourceRef="managerDecision" targetRef="daysCheck">
      <conditionExpression xsi:type="tFormalExpression">${approved == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow2_rejected" name="主管驳回" sourceRef="managerDecision" targetRef="rejectedEnd">
      <conditionExpression xsi:type="tFormalExpression">${approved == false}</conditionExpression>
    </sequenceFlow>
    <!-- ===== 请假天数判断（排他网关，无人工操作） ===== -->
    <exclusiveGateway id="daysCheck" name="请假天数判断"/>
    <sequenceFlow id="flow_short" name="≤3天" sourceRef="daysCheck" targetRef="hrFiling">
      <conditionExpression xsi:type="tFormalExpression">${days &lt;= 3}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_long" name="&gt;3天" sourceRef="daysCheck" targetRef="directorApproval">
      <conditionExpression xsi:type="tFormalExpression">${days &gt; 3}</conditionExpression>
    </sequenceFlow>
    <!-- ===== 总监审批（仅 >3天 才走到这里） ===== -->
    <userTask id="directorApproval" name="总监审批" flowable:candidateGroups="ROLE_DIRECTOR" flowable:formKey="leave_request_form">
      <documentation>总监审核长假申请</documentation>
    </userTask>
    <sequenceFlow id="flow3" sourceRef="directorApproval" targetRef="directorDecision"/>
    <exclusiveGateway id="directorDecision" name="总监审批决策"/>
    <sequenceFlow id="flow3_approved" name="总监通过" sourceRef="directorDecision" targetRef="hrFiling">
      <conditionExpression xsi:type="tFormalExpression">${approved == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow3_rejected" name="总监驳回" sourceRef="directorDecision" targetRef="rejectedEnd">
      <conditionExpression xsi:type="tFormalExpression">${approved == false}</conditionExpression>
    </sequenceFlow>
    <!-- ===== HR备案（两条分支汇合到这里） ===== -->
    <userTask id="hrFiling" name="HR备案" flowable:candidateGroups="ROLE_HR" flowable:formKey="leave_filing_form">
      <documentation>HR确认请假信息并录入考勤系统</documentation>
    </userTask>
    <sequenceFlow id="flow4" sourceRef="hrFiling" targetRef="approvedEnd"/>
    <!-- ===== 结束 ===== -->
    <endEvent id="approvedEnd" name="请假通过"/>
    <endEvent id="rejectedEnd" name="请假驳回"/>
  </process>
  <!-- ==================== 图形布局 ==================== -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_leave">
    <bpmndi:BPMNPlane id="BPMNPlane_leave" bpmnElement="leave-request">
      <bpmndi:BPMNShape id="startShape" bpmnElement="startEvent">
        <dc:Bounds x="15" y="250" width="30" height="30"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="managerShape" bpmnElement="managerApproval">
        <dc:Bounds x="110" y="225" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="managerDecisionShape" bpmnElement="managerDecision">
        <dc:Bounds x="290.0" y="240.0" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="daysCheckShape" bpmnElement="daysCheck">
        <dc:Bounds x="400.0" y="240.0" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="directorShape" bpmnElement="directorApproval">
        <dc:Bounds x="510.0" y="120.0" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="directorDecisionShape" bpmnElement="directorDecision">
        <dc:Bounds x="690" y="135" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="hrShape" bpmnElement="hrFiling">
        <dc:Bounds x="800" y="225" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approvedShape" bpmnElement="approvedEnd">
        <dc:Bounds x="980" y="250" width="30" height="30"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rejectedShape" bpmnElement="rejectedEnd">
        <dc:Bounds x="595" y="400" width="30" height="30"/>
      </bpmndi:BPMNShape>
      <!-- 连线 -->
      <bpmndi:BPMNEdge id="flow1Edge" bpmnElement="flow1">
        <di:waypoint x="45" y="265"/>
        <di:waypoint x="110" y="265"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow2Edge" bpmnElement="flow2">
        <di:waypoint x="230" y="265"/>
        <di:waypoint x="290.0" y="265.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow2ApprovedEdge" bpmnElement="flow2_approved">
        <di:waypoint x="340.0" y="265.0"/>
        <di:waypoint x="400.0" y="265.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow2RejectedEdge" bpmnElement="flow2_rejected">
        <di:waypoint x="315.0" y="290.0"/>
        <di:waypoint x="315" y="415"/>
        <di:waypoint x="595" y="415"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flowShortEdge" bpmnElement="flow_short">
        <di:waypoint x="450.0" y="265.0"/>
        <di:waypoint x="800" y="265"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flowLongEdge" bpmnElement="flow_long">
        <di:waypoint x="425.0" y="240.0"/>
        <di:waypoint x="425" y="160"/>
        <di:waypoint x="510.0" y="160.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow3Edge" bpmnElement="flow3">
        <di:waypoint x="630.0" y="160.0"/>
        <di:waypoint x="690.0" y="160.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow3ApprovedEdge" bpmnElement="flow3_approved">
        <di:waypoint x="740" y="160"/>
        <di:waypoint x="860" y="160"/>
        <di:waypoint x="860" y="225"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow3RejectedEdge" bpmnElement="flow3_rejected">
        <di:waypoint x="715" y="185"/>
        <di:waypoint x="715" y="415"/>
        <di:waypoint x="625.0" y="415.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow4Edge" bpmnElement="flow4">
        <di:waypoint x="920" y="265"/>
        <di:waypoint x="980" y="265"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
