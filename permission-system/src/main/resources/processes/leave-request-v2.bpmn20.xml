<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:flowable="http://flowable.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://www.flowable.org/processdef" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/BPMN20.xsd">
  <process id="leave-request-v2" name="请假审批V2（流程变量指定审批人）" isExecutable="true">
    <!-- 流程发起人 -->
    <startEvent id="startEvent" name="提交申请" flowable:initiator="initiator"/>
    <!-- ===== 经理审批：使用流程变量指定审批人 ===== -->
    <userTask id="managerApproval" name="经理审批" flowable:assignee="${managerApprover}">
      <documentation>经理对请假申请进行审批</documentation>
    </userTask>
    <!-- ===== 请假天数判断（排他网关） ===== -->
    <exclusiveGateway id="daysCheck" name="请假天数判断"/>
    <!-- ===== HR备案：使用流程变量指定审批人 ===== -->
    <userTask id="hrFiling" name="HR备案" flowable:assignee="${hrApprover}">
      <documentation>请假天数≤3天，HR进行备案</documentation>
    </userTask>
    <!-- ===== 总监审批：使用流程变量指定审批人 ===== -->
    <userTask id="directorApproval" name="总监审批" flowable:assignee="${directorApprover}">
      <documentation>请假超过3天需总监审批</documentation>
    </userTask>
    <!-- ===== 结束事件 ===== -->
    <endEvent id="approvedEnd" name="审批通过">
      <extensionElements>
        <flowable:executionListener event="end" class="org.xiaoxu.workflow.listener.ApprovalEmailListener"/>
      </extensionElements>
    </endEvent>
    <endEvent id="rejectedEnd" name="审批驳回">
      <extensionElements>
        <flowable:executionListener event="end" class="org.xiaoxu.workflow.listener.RejectionEmailListener"/>
      </extensionElements>
    </endEvent>
    <!-- ===== 流程连线 ===== -->
    <!-- 提交申请 → 经理审批 -->
    <sequenceFlow id="flow1" sourceRef="startEvent" targetRef="managerApproval"/>
    <!-- 经理审批 → 天数判断 -->
    <sequenceFlow id="flow2" sourceRef="managerApproval" targetRef="daysCheck"/>
    <!-- 经理驳回 → 驳回结束 -->
    <sequenceFlow id="flow3" name="经理驳回" sourceRef="daysCheck" targetRef="rejectedEnd">
      <conditionExpression xsi:type="tFormalExpression">${approved == false}</conditionExpression>
    </sequenceFlow>
    <!-- 天数≤3天 → HR备案 -->
    <sequenceFlow id="flow4" name="≤3天" sourceRef="daysCheck" targetRef="hrFiling">
      <conditionExpression xsi:type="tFormalExpression">${approved == true and days &lt;= 3}</conditionExpression>
    </sequenceFlow>
    <!-- 天数>3天 → 总监审批 -->
    <sequenceFlow id="flow5" name="&gt;3天" sourceRef="daysCheck" targetRef="directorApproval">
      <conditionExpression xsi:type="tFormalExpression">${approved == true and days &gt; 3}</conditionExpression>
    </sequenceFlow>
    <!-- HR备案 → 审批通过 -->
    <sequenceFlow id="flow6" sourceRef="hrFiling" targetRef="approvedEnd"/>
    <!-- 总监审批通过 → 审批通过 -->
    <sequenceFlow id="flow7" name="总监通过" sourceRef="directorApproval" targetRef="approvedEnd">
      <conditionExpression xsi:type="tFormalExpression">${approved == true}</conditionExpression>
    </sequenceFlow>
    <!-- 总监驳回 → 驳回结束 -->
    <sequenceFlow id="flow8" name="总监驳回" sourceRef="directorApproval" targetRef="rejectedEnd">
      <conditionExpression xsi:type="tFormalExpression">${approved == false}</conditionExpression>
    </sequenceFlow>
  </process>
  <!-- ===== 流程图布局 ===== -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_leave-request-v2">
    <bpmndi:BPMNPlane bpmnElement="leave-request-v2" id="BPMNPlane_leave-request-v2">

      <!-- 开始 -->
      <bpmndi:BPMNShape bpmnElement="startEvent" id="shape_start">
        <omgdc:Bounds x="100" y="200" width="30" height="30"/>
      </bpmndi:BPMNShape>

      <!-- 经理审批 -->
      <bpmndi:BPMNShape bpmnElement="managerApproval" id="shape_manager">
        <omgdc:Bounds x="190" y="175" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <!-- 网关 -->
      <bpmndi:BPMNShape bpmnElement="daysCheck" id="shape_gateway" isMarkerVisible="true">
        <omgdc:Bounds x="350" y="195" width="40" height="40"/>
      </bpmndi:BPMNShape>

      <!-- 总监审批 -->
      <bpmndi:BPMNShape bpmnElement="directorApproval" id="shape_director">
        <omgdc:Bounds x="470" y="70" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <!-- HR备案 -->
      <bpmndi:BPMNShape bpmnElement="hrFiling" id="shape_hr">
        <omgdc:Bounds x="470" y="290" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <!-- 审批通过 -->
      <bpmndi:BPMNShape bpmnElement="approvedEnd" id="shape_end_ok">
        <omgdc:Bounds x="700" y="200" width="30" height="30"/>
      </bpmndi:BPMNShape>

      <!-- 驳回 -->
      <bpmndi:BPMNShape bpmnElement="rejectedEnd" id="shape_end_no">
        <omgdc:Bounds x="350" y="450" width="30" height="30"/>
      </bpmndi:BPMNShape>

      <!-- flow1 -->
      <bpmndi:BPMNEdge bpmnElement="flow1" id="edge1">
        <omgdi:waypoint x="130" y="215"/>
        <omgdi:waypoint x="190" y="215"/>
      </bpmndi:BPMNEdge>

      <!-- flow2 -->
      <bpmndi:BPMNEdge bpmnElement="flow2" id="edge2">
        <omgdi:waypoint x="290" y="215"/>
        <omgdi:waypoint x="350" y="215"/>
      </bpmndi:BPMNEdge>

      <!-- flow3 驳回 -->
      <bpmndi:BPMNEdge bpmnElement="flow3" id="edge3">
        <omgdi:waypoint x="370" y="235"/>
        <omgdi:waypoint x="370" y="450"/>
      </bpmndi:BPMNEdge>

      <!-- flow4 <=3天 -->
      <bpmndi:BPMNEdge bpmnElement="flow4" id="edge4">
        <omgdi:waypoint x="390" y="215"/>
        <omgdi:waypoint x="430" y="215"/>
        <omgdi:waypoint x="430" y="330"/>
        <omgdi:waypoint x="470" y="330"/>
      </bpmndi:BPMNEdge>

      <!-- flow5 >3天 -->
      <bpmndi:BPMNEdge bpmnElement="flow5" id="edge5">
        <omgdi:waypoint x="370" y="195"/>
        <omgdi:waypoint x="370" y="110"/>
        <omgdi:waypoint x="470" y="110"/>
      </bpmndi:BPMNEdge>

      <!-- flow6 HR->通过 -->
      <bpmndi:BPMNEdge bpmnElement="flow6" id="edge6">
        <omgdi:waypoint x="570" y="330"/>
        <omgdi:waypoint x="650" y="330"/>
        <omgdi:waypoint x="650" y="215"/>
        <omgdi:waypoint x="700" y="215"/>
      </bpmndi:BPMNEdge>

      <!-- flow7 总监通过 -->
      <bpmndi:BPMNEdge bpmnElement="flow7" id="edge7">
        <omgdi:waypoint x="570" y="110"/>
        <omgdi:waypoint x="650" y="110"/>
        <omgdi:waypoint x="650" y="215"/>
        <omgdi:waypoint x="700" y="215"/>
      </bpmndi:BPMNEdge>

      <!-- flow8 总监驳回 -->
      <bpmndi:BPMNEdge bpmnElement="flow8" id="edge8">
        <omgdi:waypoint x="520" y="150"/>
        <omgdi:waypoint x="520" y="465"/>
        <omgdi:waypoint x="380" y="465"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
