<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.xiaoxu.mapper.UserMapper">
    <insert id="insert">
        insert into it_user(id,name,password) values(#{user.id},#{user.name},#{user.password})
    </insert>


    <select id="getUserById" resultType="org.xiaoxu.entity.vo.UserVO">
        select id,name,gender from it_user where id = #{id}
    </select>
    <select id="getUserByUserName" resultType="org.xiaoxu.entity.vo.UserVO">
        select id,name,gender from it_user
        <where>
            <if test="userName != null">
                and name like concat('%',#{userName},'%')
            </if>
        </where>
    </select>
    <select id="getUserByName" resultType="org.xiaoxu.entity.User">
        select * from it_user where name = #{userName}
    </select>
</mapper>